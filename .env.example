# Redis Cluster nodes — set all three for a full cluster audit.
# For local Docker testing the defaults below work out of the box.
REDIS_HOST_1=127.0.0.1
REDIS_PORT_1=6777

REDIS_HOST_2=127.0.0.1
REDIS_PORT_2=6778

REDIS_HOST_3=127.0.0.1
REDIS_PORT_3=6779

# Leave empty if there is no password / no ACL user (uses default user)
REDIS_PASSWORD=
# Redis 6+ ACL username. Leave empty to use the default user.
REDIS_USERNAME=

# Set to true when running against the local Docker cluster on Mac.
# The Docker bridge IPs (172.29.0.x) aren't reachable from the host —
# this flag enables remapping MOVED redirects to 127.0.0.1:port.
# Leave false (or remove) for production.
REDIS_DOCKER_REMAP=false

# Audit tuning
BIG_KEY_TOP_N=30          # How many big keys to surface in the report
SCAN_SAMPLE_SIZE=5000     # Max keys scanned per shard for type/TTL analysis
SLOWLOG_MAX_ENTRIES=25    # Slowlog entries to fetch per node
